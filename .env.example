# Public site URL (used for canonical URLs, sitemap, llms.txt and email links)
NEXT_PUBLIC_SITE_URL=https://ellafive.com

# Resend: subscriptions are off unless RESEND_API_KEY, EMAIL_FROM and RESEND_AUDIENCE_ID are all set
RESEND_API_KEY=
EMAIL_FROM="Ella <ella@example.com>"
RESEND_AUDIENCE_ID=
# One Resend Topic per list (contacts opt in per topic)
RESEND_TOPIC_TECHNICAL=
RESEND_TOPIC_DESIGN=
RESEND_TOPIC_RESEARCH=
RESEND_TOPIC_PRODUCT=
RESEND_TOPIC_GROWTH=
# Optional HMAC key for signed confirm/unsubscribe links (defaults to RESEND_API_KEY)
SUBSCRIBE_SECRET=
